# Port the API listens on
PORT=4000

# MongoDB connection string. Local Docker compose uses the service name "mongo".
# For MongoDB Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mechatronic_trainer
MONGODB_URI=mongodb://127.0.0.1:27017/mechatronic_trainer

# Signs session cookies. MUST be unique and at least 32 characters in production.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Browser origins allowed to call the API with credentials. Comma separated.
WEB_ORIGIN=http://localhost:3000

# Set true when the API runs behind a reverse proxy or load balancer,
# so client IPs and secure cookies are resolved correctly.
TRUST_PROXY=false

# Set true only when the browser calls the API on a different site rather than
# through the Next.js proxy. Forces SameSite=None; Secure on the session cookie.
CROSS_SITE_COOKIES=false
