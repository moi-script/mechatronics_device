# Copy to apps/mobile/keystore.properties and fill in, then `npm run apk` signs
# the release build with your own key instead of the throwaway debug one.
#
# Create the key once (JDK 21's keytool, 27 years so it outlives the course):
#
#   keytool -genkeypair -v -keystore apps/mobile/mechatronic.jks \
#     -alias mechatronic -keyalg RSA -keysize 2048 -validity 10000
#
# Keep the .jks file and these passwords. Lose them and no future build can
# ever update an installed app: Android will only take an update signed with
# the same key, so everyone would have to uninstall first — losing whatever
# they had saved on the device.
#
# Neither this file nor the .jks is committed.
storeFile=mechatronic.jks
storePassword=
keyAlias=mechatronic
keyPassword=
