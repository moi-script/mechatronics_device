# Settings for `docker compose up`. Copy to .env and fill in.
# Never commit .env - it is gitignored.

# Signs session cookies. Must be unique and at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Public origin the browser uses. Must match where you actually serve the app.
WEB_ORIGIN=http://localhost:3000

# Host port the web server is published on. Change it if 3000 is taken.
WEB_PORT=3000
